# Environments and caches
.venv
.venv-*
__pycache__/
*.pyc
.DS_Store
hf_cache
nltk_data/
graphify-out/

# External data (clone BIPIA into data/raw/BIPIA)
data/raw/
# Transfer sets rebuilt from public sources by scripts/build_transfer_sets.sh (not redistributed)
data/transfer/

# Large model checkpoints and logs
checkpoints/deberta*/
logs/

# Generated view of the run directories (python src/runlog.py registry); never committed
results/REGISTRY.md

# Generated annotation pages (scripts/make_annotation_sheet.py); exported CSVs next to them are tracked
annotation/*/*.html

# Agent-style training realizations (python src/agent_pipeline.py regenerates them byte-identically; sha256 in each manifest.json)
data/agent_v1/split_seed_*/*.csv
data/agent_v2/split_seed_*/*.csv

# Model checkpoints (tracked exceptions such as checkpoints/tfidf_lr_model.pkl stay tracked)
checkpoints/
